@page "/"
@using MisterioDoCaixa.Services
@inject CaixaService CaixaService

<div class="cashier-page">
    <div class="cashier-card">
        <button class="restart-button" type="button" @onclick="Reiniciar">Reiniciar</button>

        <div class="text-center mb-4">
            <span class="eyebrow">Fechamento diário</span>
            <h1>O Mistério do Caixa</h1>
            <p class="subtitle mb-0">Sistema de Fechamento de Vendas</p>
        </div>

        <div class="sales-panel mb-4">
            <h2>Vendas registradas</h2>
            <div class="sale-row"><span>Venda 1</span><strong>R$ 100,00</strong></div>
            <div class="sale-row"><span>Venda 2</span><strong>R$ 200,00</strong></div>
            <div class="sale-row"><span>Venda 3</span><strong>R$ 50,00</strong></div>
        </div>

        <button class="btn btn-primary btn-lg w-100" type="button" @onclick="CalcularTotal">Calcular Total</button>

        <div class="result-panel mt-4 text-center">
            <span>Total calculado</span>
            <strong>R$ @totalCalculado.ToString("N2")</strong>
        </div>
    </div>
</div>

@code {
    private int totalCalculado = 0;

    private void CalcularTotal()
    {
        totalCalculado = CaixaService.CalcularTotal();
    }

    private void Reiniciar()
    {
        totalCalculado = 0;
    }
}
